<?xml version="1.0" encoding="utf-8"?>
<!--
    "Drive here": the waypoint that shortens the fix fastest.

    A chevron inside a ring, deliberately not an arrow. An arrow on a map
    reads as a heading to travel, and this is a place to be rather than a
    direction to point. The ring says "a spot", the chevron says "go".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"
        android:fillColor="#00000000"
        android:pathData="M32,32 m-24,0 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M24,22 L40,32 L24,42" />
</vector>
