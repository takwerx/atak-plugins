<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="false"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/spike_heading"
            android:textAllCaps="true"
            android:textSize="10sp"
            android:alpha="0.6"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/spike_explain"
            android:textSize="13sp"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/btn_inject"
            style="@style/TakwerxButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/spike_inject" />

        <Button
            android:id="@+id/btn_dump"
            style="@style/TakwerxButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/spike_dump" />

        <TextView
            android:id="@+id/spike_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="13sp"
            android:text="@string/spike_idle" />

    </LinearLayout>
</ScrollView>
