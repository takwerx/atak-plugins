<?xml version="1.0" encoding="utf-8"?>
<!-- The map key, as the alert list's footer. Its lines are built in code from the
     same color call the map draws with, so the key and the map cannot disagree. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/map_key_heading"
        style="@style/TakwerxSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="14dp"
        android:visibility="gone"
        android:text="@string/heading_map_key" />

    <LinearLayout
        android:id="@+id/map_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
