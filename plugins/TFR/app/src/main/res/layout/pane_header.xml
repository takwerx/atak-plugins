<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <!-- The switch, and it is the first thing in the pane on purpose: it decides whether the
         plugin touches the network at all, so nothing should be able to happen before it is
         seen. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FAA temporary flight restrictions"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <Button
            android:id="@+id/tfr_switch"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_off_label" />
    </LinearLayout>

    <TextView
        android:id="@+id/tfr_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:textColor="@color/dim_text"
        android:textSize="13sp"
        android:text="off" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/tfr_types"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Types" />

        <Button
            android:id="@+id/tfr_refresh"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="Refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/tfr_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:textAllCaps="true"
        android:textSize="10sp"
        android:textColor="@color/white"
        android:alpha="0.6"
        android:text="in view" />

    <!-- What is on the map but not in this list, said in words. A list that silently shows a
         fraction of what is drawn reads as the whole picture. -->
    <TextView
        android:id="@+id/tfr_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:textColor="@color/dim_text"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
