<?xml version="1.0" encoding="utf-8"?>
<!--
    The MAST pane: a header of value buttons (mission, mode, feed, floor), then the
    mission's tool tiles, FOBS-style, three per row, built in code from the mission
    file. Every button is TakwerxButton (CLAUDE.md, "Plugin UI standard").
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Button
                android:id="@+id/mast_mission"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:singleLine="false"
                android:maxLines="2"
                android:ellipsize="end" />

            <Button
                android:id="@+id/mast_mode"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:singleLine="false"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/mast_feed"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:singleLine="false"
                android:maxLines="2"
                android:ellipsize="end" />

            <Button
                android:id="@+id/mast_floor"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:singleLine="false"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mast_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:id="@+id/mast_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:alpha="0.6"
            android:paddingTop="14dp"
            android:paddingBottom="4dp"
            android:paddingLeft="6dp" />

        <LinearLayout
            android:id="@+id/mast_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        </LinearLayout>

        <!-- MAST's own list of the image overlays (school floor plans): Overlay
             Manager's rows, inside the pane, with a way back to the tiles. -->
        <LinearLayout
            android:id="@+id/mast_maps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/mast_maps_back"
                    style="@style/TakwerxButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/back_to_tools" />

                <Button
                    android:id="@+id/mast_maps_scope"
                    style="@style/TakwerxButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <EditText
                android:id="@+id/mast_maps_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/maps_search_hint"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:imeOptions="actionDone|flagNoFullscreen"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/maps_section"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:alpha="0.6"
                android:paddingTop="14dp"
                android:paddingBottom="4dp"
                android:paddingLeft="6dp" />

            <TextView
                android:id="@+id/mast_maps_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="6dp"
                android:paddingTop="6dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/mast_maps_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
