<?xml version="1.0" encoding="utf-8"?>
<!-- SAWTI, the Santa Ana Wildfire Threat Index: the Forest Service site's forecast
     page in the pane. A zone picker, four days, the level, the three gauges, the
     forecaster's words, the recommended actions and the zones-by-days table. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="false"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/heading_sawti"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:paddingTop="8dp"
            android:alpha="0.6" />

        <!-- Before the operator has allowed it: what it is and one button. -->
        <LinearLayout
            android:id="@+id/sawti_gate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:text="@string/sawti_gate_text" />

            <Button
                android:id="@+id/sawti_load"
                style="@style/TakwerxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/sawti_load" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sawti_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/sawti_zone"
                style="@style/TakwerxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="left|center_vertical"
                android:text="" />

            <LinearLayout
                android:id="@+id/sawti_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/sawti_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="" />

            <TextView
                android:id="@+id/sawti_meaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:text="" />

            <!-- Threat Level | Wind Strength | Fuel Moisture, built in code. -->
            <LinearLayout
                android:id="@+id/sawti_gauges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/heading_sawti_event"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:alpha="0.6" />

            <TextView
                android:id="@+id/sawti_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:text="" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/heading_sawti_actions"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:alpha="0.6" />

            <TextView
                android:id="@+id/sawti_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:text="" />

            <LinearLayout
                android:id="@+id/sawti_links"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/heading_sawti_table"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:alpha="0.6" />

            <LinearLayout
                android:id="@+id/sawti_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/sawti_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:text="" />

        <TextView
            android:id="@+id/sawti_credit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="11sp"
            android:alpha="0.6"
            android:text="" />
    </LinearLayout>
</ScrollView>
