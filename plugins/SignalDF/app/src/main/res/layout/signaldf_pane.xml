<?xml version="1.0" encoding="utf-8"?>
<!--
    The Signal DF pane.

    The wide/narrow button is pinned in the root LinearLayout below the
    ScrollView rather than placed inside it, so it stays reachable however long
    the bearing list gets. There is no ListView anywhere here: a ListView inside
    a ScrollView collapses to one row, and the per-VFO rows are added to a plain
    LinearLayout so the whole pane is one scroller.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionHeading"
                android:text="Radio" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="Not connected" />

            <TextView
                android:id="@+id/feed_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:alpha="0.75"
                android:paddingTop="2dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/host"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="krakensdr.local" />

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/connect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="Connect" />
            </LinearLayout>

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/radio_setup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Radio setup" />

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/array_calc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Antenna array sizing" />

            <TextView
                style="@style/SectionHeading"
                android:text="Array heading" />

            <TextView
                android:id="@+id/heading_provenance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:text="Array heading: unknown" />

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/heading_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Heading source: radio" />

            <TextView
                style="@style/SectionHeading"
                android:text="Find" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/collect_toggle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="COLLECTING OFF" />

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/collect_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="Clear" />
            </LinearLayout>

            <TextView
                android:id="@+id/collect_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:alpha="0.85"
                android:lineSpacingMultiplier="1.15"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:text="Not collecting." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:orientation="horizontal">

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/show_lobs"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="LOBS ON" />

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/show_fix"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="FIX ON" />

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/go_to_fix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="Go to" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeading"
                android:id="@+id/bearings_heading"
                android:text="Bearings" />

            <TextView
                android:id="@+id/bearings_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:alpha="0.75"
                android:text="Nothing yet." />

            <LinearLayout
                android:id="@+id/vfo_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp" />

            <TextView
                style="@style/SectionHeading"
                android:text="Transmit" />

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/share_feed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Feed: not set" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/share_stale"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Stale time: 30 seconds" />

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/share_toggle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="TRANSMIT OFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/share_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:alpha="0.75"
                android:paddingTop="2dp"
                android:text="Not transmitting." />


            <TextView
                android:id="@+id/unverified"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <Button
        style="@style/TakwerxButton"
        android:id="@+id/wide_narrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:text="Open wide" />

</LinearLayout>
