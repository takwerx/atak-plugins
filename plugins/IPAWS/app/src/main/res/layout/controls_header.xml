<?xml version="1.0" encoding="utf-8"?>
<!-- The filter controls. This is the alert list's header view, not a panel above
     it: a ListView inside a ScrollView collapses to one row, so the whole pane has
     to be a single scroller. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- What is on the map, first: Feature Layer's heading row with its All ON / All
         OFF switch at the end, then the key. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp">

        <TextView
            style="@style/TakwerxSectionHeading"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingTop="0dp"
            android:text="@string/heading_map" />

        <Button
            android:id="@+id/btn_all"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="90dp" />
    </LinearLayout>

    <!-- Zoom gate, Feature Layer's row: set it by example, or pick what the scale
         bar reads. Nothing draws when zoomed out further than that. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:text="@string/zoom_gate" />

        <Button
            android:id="@+id/btn_use_zoom"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:text="@string/use_this_zoom" />

        <Button
            android:id="@+id/btn_gate"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:minWidth="110dp" />
    </LinearLayout>

    <!-- The map key. Closed by default so the filters are still on the first
         screen; its lines are built in code from the same color call the map
         draws with. -->
    <Button
        android:id="@+id/btn_map_key"
        style="@style/TakwerxButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:text="@string/map_key_show" />

    <LinearLayout
        android:id="@+id/map_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingLeft="4dp"
        android:visibility="gone" />

    <TextView
        style="@style/TakwerxSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/heading_where" />

    <Button
        android:id="@+id/btn_regions"
        style="@style/TakwerxButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btn_states"
        style="@style/TakwerxButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btn_counties"
        style="@style/TakwerxButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" />

    <!-- Distance scope, Feature Layer's block: what it is now, a slider, where it is
         measured from, and "Use this extent" / "Presets". Narrows the list, the map
         and notifications alike. -->
    <TextView
        style="@style/TakwerxSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/heading_distance" />

    <TextView
        android:id="@+id/scope_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/white" />

    <SeekBar
        android:id="@+id/scope_seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:max="50" />

    <Button
        android:id="@+id/btn_scope_from"
        style="@style/TakwerxButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btn_scope_extent"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/use_this_extent" />

        <Button
            android:id="@+id/btn_scope_presets"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/presets" />
    </LinearLayout>

    <TextView
        style="@style/TakwerxSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/heading_types" />

    <Button
        android:id="@+id/btn_categories"
        style="@style/TakwerxButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btn_events"
        style="@style/TakwerxButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" />

    <TextView
        style="@style/TakwerxSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/heading_severity" />

    <Button
        android:id="@+id/btn_severity"
        style="@style/TakwerxButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" />

    <TextView
        style="@style/TakwerxSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/heading_updates" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_interval"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp" />

        <Button
            android:id="@+id/btn_notify"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_refresh"
        style="@style/TakwerxButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/refresh_now" />

    <TextView
        android:id="@+id/alerts_heading"
        style="@style/TakwerxSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="14dp"
        android:text="@string/heading_alerts" />

</LinearLayout>
