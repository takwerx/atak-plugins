<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App -->
    <string name="app_name">UAS Flight Plan</string>
    <!-- description -->
    <string name="app_desc">Launch point ground elevation and the terrain above your MSL ceiling, painted as islands</string>

    <!-- Sections -->
    <string name="section_launch">Launch point</string>
    <string name="section_ceiling">Ceiling</string>
    <string name="section_islands">Islands</string>

    <!-- Controls -->
    <string name="tap_map">Tap the map</string>
    <string name="use_position">My position</string>
    <string name="cancel">Cancel</string>
    <string name="clear">Clear</string>
    <string name="islands_on">Islands ON</string>
    <string name="islands_off">Islands OFF</string>

    <!-- On the map -->
    <string name="launch_marker">Launch</string>
    <string name="prompt_tap_launch">Tap the map where you will launch</string>

    <!-- Readouts. %1$s is an altitude with its unit and MSL already on it. -->
    <string name="ground_here">Ground here: %1$s (0 AGL)</string>
    <string name="ceiling_line">%1$s is %2$s above your launch point.</string>

    <!-- Status line. Says what is happening, what was painted, or why nothing is drawn. -->
    <string name="status_idle">Tap the map to place the launch point. The islands are painted inside a circle around it.</string>
    <string name="status_picking">Tap the map where you will launch. Back cancels.</string>
    <string name="status_working">Reading the ground…</string>
    <string name="status_reading">Reading the terrain within %1$s…</string>
    <string name="status_no_gps">No GPS fix, so there is no position to use. Tap the map instead.</string>
    <string name="all_under_water">Everything in the circle is under the ceiling.</string>
    <string name="islands_share">Islands cover %.0f%% of the circle.</string>
    <string name="highest_ground">Highest ground in the circle: %1$s.</string>
    <string name="terrain_detail">Circle %1$s. Terrain from %2$s in %3$s cells.</string>
    <string name="missing_share">%.0f%% of the circle has no terrain data and is not painted.</string>
    <string name="fixed_note">Ceiling is fixed at the launch ground plus 1,000 ft, rounded up to 100, and the circle at 1 mi, until the pickers exist.</string>
</resources>
