<?xml version="1.0" encoding="utf-8"?>
<!-- Four pages in one pane, swapped by visibility: the main screen (a list whose
     header holds the controls), Settings, a page being read, and IWI (its own pages,
     iwi_layout.xml, inflated into iwi_host). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp">
    <!-- Pinned, outside the list, so it never scrolls away. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:textSize="13sp"
        android:textColor="@color/white" />
    <!-- The controls are this list's header, not a ScrollView above it: a ListView
         inside a ScrollView gets one row of height. -->
    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#20FFFFFF"
        android:dividerHeight="1dp"
        android:fadeScrollbars="false"
        android:listSelector="@android:color/transparent" />
    <LinearLayout
        android:id="@+id/settings_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">
            <Button
                android:id="@+id/btn_settings_back"
                style="@style/TakwerxButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="90dp"
                android:text="@string/back" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/settings_title"
                android:text="@string/settings" />
            <ImageButton
                android:id="@+id/btn_settings_wide"
                style="@style/TakwerxIconButton"
                android:layout_weight="0"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:contentDescription="@string/iwi_wide_desc"
                android:src="@drawable/ic_wide" />
        </LinearLayout>
        <!-- focusableInTouchMode + beforeDescendants: the scroller does not jump to a
             button that is rebuilt. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:focusableInTouchMode="true"
            android:descendantFocusability="beforeDescendants">
            <LinearLayout
                android:id="@+id/settings_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">
                <TextView
                    style="@style/TakwerxSectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="@string/tile_irpg" />
                <!-- A drop-down row reading "Text size: Normal" (plugin-ui skill). -->
                <Button
                    android:id="@+id/btn_text_size"
                    style="@style/TakwerxButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
                <TextView
                    style="@style/TakwerxSectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:text="@string/heading_lessons" />
                <!-- Area, Types and the map key, as drop-down rows built in code. -->
                <LinearLayout
                    android:id="@+id/lessons_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <!-- IWI's trauma center rows, iwi_settings.xml, under their own heading. -->
                <LinearLayout
                    android:id="@+id/iwi_settings_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/reader_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">
            <Button
                android:id="@+id/btn_reader_back"
                style="@style/TakwerxButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="90dp"
                android:text="@string/back" />
            <TextView
                android:id="@+id/reader_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/white" />
            <ImageButton
                android:id="@+id/btn_reader_wide"
                style="@style/TakwerxIconButton"
                android:layout_weight="0"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:contentDescription="@string/iwi_wide_desc"
                android:src="@drawable/ic_wide" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/reader_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:focusableInTouchMode="true"
            android:descendantFocusability="beforeDescendants">
            <LinearLayout
                android:id="@+id/reader_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp" />
        </ScrollView>
        <!-- Read the book through: the page before and the page after, by name. -->
        <LinearLayout
            android:id="@+id/reader_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <Button
                android:id="@+id/btn_prev"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btn_next"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/iwi_host"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
