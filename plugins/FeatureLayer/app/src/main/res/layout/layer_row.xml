<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">
    <!-- One line per layer, Atmosphere's layers page: the head is the layer's switch
         and says its name and state, the arrow opens its controls. The arrow works
         while the layer is OFF, so a layer can be set up, refreshed or removed without
         drawing it. A long name is cut in the middle, never at the end, so ON or OFF
         always shows ("CA Air Intel perimeters (FIRIS, CAL FIR..." hid it). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/row_toggle"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="left|center_vertical"
            android:ellipsize="middle" />
        <ImageButton
            android:id="@+id/row_expand"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="Show or hide the controls for this layer"
            android:src="@drawable/ic_expand" />
    </LinearLayout>
    <!-- Shown with the controls only: a closed row is one line (operator, 2026-10-05:
         "i want it compact, i can see that when i expand it"). -->
    <TextView
        android:id="@+id/row_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#BBBBBB"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
    <LinearLayout
        android:id="@+id/row_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <!-- Only This Fire is on: back to every fire. -->
        <Button
            android:id="@+id/row_show_all"
            style="@style/TakwerxButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Show All Fires"
            android:visibility="gone" />
        <!-- The fire layers' map key: each marker beside what it means, built in code
             from the images the map draws. Gone on every other layer. -->
        <LinearLayout
            android:id="@+id/row_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="6dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Map key"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:alpha="0.6"
                android:textColor="#FFFFFF" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/row_sets"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Features" />
            <Button
                android:id="@+id/row_goto"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="Go to" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">
            <Button
                android:id="@+id/row_auto"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Auto: 5 min" />
            <Button
                android:id="@+id/row_refresh"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="Refresh" />
            <Button
                android:id="@+id/row_remove"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="Remove" />
        </LinearLayout>
        <!-- Where a live layer looks. Cam Depot's control, word for word, shown only on
             layers that have a scope (DART): the label says the state, the slider sets a
             radius (0 = what is in view), the From button names the point it measures
             from, and the two below set the radius from the map or from a list. -->
        <LinearLayout
            android:id="@+id/row_scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Distance from a point"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:paddingTop="6dp"
                android:alpha="0.6" />
            <TextView
                android:id="@+id/row_scope_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#FFFFFF" />
            <SeekBar
                android:id="@+id/row_scope_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50" />
            <Button
                android:id="@+id/row_scope_from"
                style="@style/TakwerxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/row_scope_extent"
                    style="@style/TakwerxButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Use this extent" />
                <Button
                    android:id="@+id/row_scope_preset"
                    style="@style/TakwerxButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="Presets" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
