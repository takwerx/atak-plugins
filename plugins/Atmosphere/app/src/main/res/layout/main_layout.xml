<?xml version="1.0" encoding="utf-8"?>
<!-- The pane: the icon row pinned on top, page dots under it, and the pages in a
     pager below (the SDK helloworld TabViewDropDown pattern, ATAK's own ViewPager).
     A swipe or the arrow turns the page; each page scrolls on its own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginLeft="3dp"
    android:layout_marginRight="3dp">

        <!-- The icon row: point modes, favorites, units, wide, refresh, settings.
             44 dp targets on ATAK's own button background, white masks tinted green
             for the mode in use (the Traffic toggle convention). Replaces the Source
             and Where button rows, so the readout starts one row down. -->
        <LinearLayout
            android:id="@+id/icon_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <ImageButton
                android:id="@+id/mode_self"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/self_position"
                android:src="@drawable/ic_point_self" />

            <ImageButton
                android:id="@+id/mode_center"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/map_center"
                android:src="@drawable/ic_point_center" />

            <ImageButton
                android:id="@+id/mode_pick"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/pick_point"
                android:src="@drawable/ic_point_pick" />

            <ImageButton
                android:id="@+id/favorites_button"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/favorites_title"
                android:src="@drawable/ic_favorites" />

            <Button
                android:id="@+id/units_button"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="@string/units_metric" />

            <ImageButton
                android:id="@+id/wide_button"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/wide"
                android:src="@drawable/ic_wide" />

            <ImageButton
                android:id="@+id/page_button"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/next_page"
                android:src="@drawable/ic_page_next" />

            <ImageButton
                android:id="@+id/refresh_button"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/refresh"
                android:src="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/settings_button"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/page_dots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="2dp" />

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
</LinearLayout>
