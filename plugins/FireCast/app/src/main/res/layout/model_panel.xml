<?xml version="1.0" encoding="utf-8"?>
<!-- The model page. Back, Run model, Rerun and Clear all are pinned (operator,
     2026-11-02); Start from leads the Start and conditions fold on a line of its own,
     so its value is never cut off; everything else, the
     settings and the run's text, is one scroller, so the output is always reachable
     (operator, 2026-10-12: "now I can't scroll up and see the output"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <Button
            android:id="@+id/btn_back"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back" />
        <Button
            android:id="@+id/btn_run"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="Run model" />
        <Button
            android:id="@+id/btn_rerun"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="Rerun" />
        <Button
            android:id="@+id/btn_clear"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="Clear all" />
    </LinearLayout>
    <!-- What to do with the run the page shows, pinned under the top line (operator, 2026-11-02). -->
    <LinearLayout
        android:id="@+id/run_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="6dp"
        android:visibility="gone">
        <Button
            android:id="@+id/btn_size"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Predicted Fire Size: Median" />
        <Button
            android:id="@+id/btn_send"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="Send run" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">
            <!-- Start and conditions: one bar that folds the settings and the start note away. -->
            <TextView
                android:id="@+id/settings_pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <LinearLayout
                android:id="@+id/settings_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <Button
                android:id="@+id/btn_place"
                style="@style/TakwerxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Start from: choose" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:paddingTop="6dp">
                <Button
                    android:id="@+id/btn_conditions"
                    style="@style/TakwerxTileButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Conditions:\nAs observed" />
                <Button
                    android:id="@+id/btn_station"
                    style="@style/TakwerxTileButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="Weather:\nautomatic" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:paddingTop="6dp">
                <Button
                    android:id="@+id/btn_started"
                    style="@style/TakwerxTileButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Started:\nnot known" />
                <Button
                    android:id="@+id/btn_horizon"
                    style="@style/TakwerxTileButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="Horizon:\n1 hour" />
            </LinearLayout>
            <TextView
                android:id="@+id/start_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textSize="16sp"
                android:textColor="#FFFFFF" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/model_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
