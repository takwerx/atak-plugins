<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp">

    <!-- Pinned in the pane root, not inside the list: how old the picture is has to
         be readable without scrolling to it. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:textSize="13sp"
        android:textColor="@color/white"
        android:text="@string/status_waiting" />

    <!-- The controls live in this list's header rather than in a ScrollView above
         it: a ListView inside a ScrollView gets one line of height, so the whole
         panel has to be one scroller. Click positions are offset by
         getHeaderViewsCount() because of it. -->
    <ListView
        android:id="@+id/alerts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#20FFFFFF"
        android:dividerHeight="1dp"
        android:fadeScrollbars="false"
        android:listSelector="@android:color/transparent" />

</LinearLayout>
