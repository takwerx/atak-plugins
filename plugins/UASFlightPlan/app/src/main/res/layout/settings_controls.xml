<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings page: drop-down rows reading "Name: value", closed until opened,
     so the page reads as a summary of every setting. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ====== OBSTACLES ====== A row whose head is the switch; the arrow opens
         what the layer does not show. The arrow stays while the layer is OFF. -->
    <LinearLayout
        android:id="@+id/fold_obstacles_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/fold_obstacles_head"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/fold_obstacles_chev"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/show_settings"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fold_obstacles_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingLeft="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:text="@string/obstacles_note" />
    </LinearLayout>

    <!-- ====== TALLER THAN ====== -->
    <LinearLayout
        android:id="@+id/fold_taller_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/fold_taller_head"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/fold_taller_chev"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/show_settings"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fold_taller_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <!-- Presets in ATAK's altitude unit; built in code. -->
        <LinearLayout
            android:id="@+id/taller_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- ====== TYPES ====== -->
    <LinearLayout
        android:id="@+id/fold_types_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/fold_types_head"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/fold_types_chev"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/show_settings"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fold_types_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <!-- One tile per kind, the name on one line and ON/OFF under it, with the
             count the FAA sent so the tile says what it costs; built in code. -->
        <LinearLayout
            android:id="@+id/type_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btn_types_all_on"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/all_on" />

            <Button
                android:id="@+id/btn_types_all_off"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="@string/all_off" />
        </LinearLayout>
    </LinearLayout>

    <!-- ====== HEIGHT ABOVE TERRAIN ====== -->
    <LinearLayout
        android:id="@+id/fold_flight_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/fold_flight_head"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/fold_flight_chev"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/show_settings"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fold_flight_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/flight_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <Button
            android:id="@+id/btn_flight_type"
            style="@style/TakwerxButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/type_the_height" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textSize="12sp"
            android:alpha="0.7"
            android:textColor="@color/white"
            android:text="@string/flight_note" />
    </LinearLayout>

    <!-- ====== SEPARATION ====== -->
    <LinearLayout
        android:id="@+id/fold_sep_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/fold_sep_head"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/fold_sep_chev"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/show_settings"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fold_sep_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sep_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <Button
            android:id="@+id/btn_sep_type"
            style="@style/TakwerxButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/type_the_separation" />
    </LinearLayout>

    <!-- ====== CEILING ====== -->
    <LinearLayout
        android:id="@+id/fold_ceiling_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/fold_ceiling_head"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/fold_ceiling_chev"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/show_settings"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fold_ceiling_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <!-- Step it, in the unit ATAK shows altitudes in. The tiles are built in code. -->
        <LinearLayout
            android:id="@+id/ceiling_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btn_ceiling_type"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/type_the_ceiling" />

            <Button
                android:id="@+id/btn_ceiling_above"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ====== CIRCLE ====== -->
    <LinearLayout
        android:id="@+id/fold_circle_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/fold_circle_head"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/fold_circle_chev"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/show_settings"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fold_circle_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <!-- Presets in the operator's large unit; built in code so the unit follows ATAK. -->
        <LinearLayout
            android:id="@+id/circle_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- ====== MAP KEY ====== -->
    <LinearLayout
        android:id="@+id/fold_key_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/fold_key_head"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/map_key" />

        <ImageButton
            android:id="@+id/fold_key_chev"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/show_settings"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <!-- Built in code from the overlay's own colors, so the key cannot drift from the map. -->
    <LinearLayout
        android:id="@+id/fold_key_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingLeft="4dp"
        android:visibility="gone" />

</LinearLayout>
