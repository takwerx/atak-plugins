<?xml version="1.0" encoding="utf-8"?>
<!-- The stations as a list: what the map is drawing, ordered by how far away it is.
     The filters are the same three states the symbols are colored by, so the list and
     the map can never be answering different questions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/auto_margin"
    android:paddingRight="@dimen/auto_margin">

    <TextView
        android:id="@+id/stations_page_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stations_page_heading"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:paddingTop="8dp"
        android:alpha="0.6" />

    <!-- Built in code so each carries its own count: a filter that says what it will
         cost before it is used, rather than one that has to be tried to be understood. -->
    <LinearLayout
        android:id="@+id/stations_filter_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/stations_scope_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/stations_page_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:text="" />

    <!-- The list and one station's details share the space: the details replace the
         list rather than sitting under it, because in landscape there is only room
         for a few rows and a panel below would leave none. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">

        <ListView
            android:id="@+id/stations_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbarStyle="outsideOverlay" />

        <ScrollView
            android:id="@+id/stations_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/stations_detail_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
