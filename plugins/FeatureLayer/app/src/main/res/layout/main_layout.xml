<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <!-- Pinned: stays put while the list below scrolls, so Back is always reachable. -->
  <LinearLayout
    android:id="@+id/features_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:visibility="gone">
    <Button
        android:id="@+id/btn_features_back"
        style="@style/TakwerxButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back" />
    <TextView
        android:id="@+id/features_title"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />
  </LinearLayout>

<!-- The scroller takes focus itself, or it follows a focused Button as the rows are
     rebuilt: Back from Add Layer came out scrolled down to the last opened row. -->
<ScrollView
    android:id="@+id/pane_scroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

  <LinearLayout
    android:id="@+id/features_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FIND IN THIS LAYER"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:alpha="0.6"
        android:textColor="#FFFFFF" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/layer_search_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Name, number or type"
            android:inputType="textCapWords"
            android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />
        <Button
            android:id="@+id/btn_layer_find"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="Find" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FEATURES"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:alpha="0.6"
        android:textColor="#FFFFFF"
        android:paddingTop="8dp" />
    <LinearLayout
        android:id="@+id/features_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/search_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/result_search_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Name, number or type"
            android:inputType="textCapWords"
            android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />
        <Button
            android:id="@+id/btn_result_find"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="Find" />
        <Button
            android:id="@+id/btn_result_clear"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="Clear" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">
        <Button
            android:id="@+id/btn_filter_type"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="All types" />
        <Button
            android:id="@+id/btn_from"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="From: Me" />
        <Button
            android:id="@+id/btn_sort"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="Nearest" />
    </LinearLayout>
    <TextView
        android:id="@+id/search_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#BBBBBB"
        android:paddingTop="6dp"
        android:paddingBottom="2dp" />
    <LinearLayout
        android:id="@+id/results_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
  </LinearLayout>

  <!-- A hit's details, the radial's Details inside the pane: Back to the list, Go there. -->
  <LinearLayout
    android:id="@+id/details_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <Button
            android:id="@+id/btn_details_back"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back" />
        <TextView
            android:id="@+id/pane_details_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="6dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
        <!-- A Fire History burn: Only This Fire / Show All Fires. Gone otherwise. -->
        <Button
            android:id="@+id/btn_details_only"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:text="Only This Fire"
            android:visibility="gone" />
        <!-- A fire CAL FIRE runs or posts: its incident page. Gone otherwise. -->
        <Button
            android:id="@+id/btn_details_calfire"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:text="CAL FIRE"
            android:visibility="gone" />
        <!-- A fire with an InciWeb page: opens it in the browser. Gone otherwise. -->
        <Button
            android:id="@+id/btn_details_inciweb"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:text="InciWeb"
            android:visibility="gone" />
        <Button
            android:id="@+id/btn_details_goto"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Go there" />
    </LinearLayout>
    <TextView
        android:id="@+id/pane_details_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#BBBBBB"
        android:paddingBottom="6dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ATTRIBUTES"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:alpha="0.6"
        android:textColor="#FFFFFF" />
    <TextView
        android:id="@+id/pane_details_attributes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:lineSpacingExtra="4dp"
        android:textIsSelectable="true" />
  </LinearLayout>

  <!-- The main screen is one row and the list (operator, 2026-10-05: the source row
       made searching features something only NIFC could do, and stayed picked forever).
       Add Layer opens its own page, Find searches every loaded layer. -->
  <LinearLayout
    android:id="@+id/main_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_add_layer"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Add Layer" />
        <Button
            android:id="@+id/btn_find_all"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="Find" />
        <Button
            android:id="@+id/btn_all"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="All OFF" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="LAYERS"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:alpha="0.6"
        android:textColor="#FFFFFF" />
    <LinearLayout
        android:id="@+id/layers_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    <TextView
        android:id="@+id/layers_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#BBBBBB"
        android:paddingTop="4dp"
        android:text="No layers yet. Tap Add Layer." />
  </LinearLayout>

  <!-- Add Layer: where layers come from. Its own page with Back, gone once a layer is
       added, so nothing about a source stays on the main screen. -->
  <LinearLayout
    android:id="@+id/add_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SOURCE"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:alpha="0.6"
        android:textColor="#FFFFFF" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <!-- The org's own name can run long ("Welcome to the City of Corona GIS
             System"); two lines beat an ellipsis, and the neighbors stretch to match. -->
        <Button
            android:id="@+id/btn_org"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:singleLine="false"
            android:maxLines="2"
            android:text="Pick a source" />
        <Button
            android:id="@+id/btn_signin"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:text="Sign in" />
        <Button
            android:id="@+id/btn_forget"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="6dp"
            android:text="Forget"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">
        <EditText
            android:id="@+id/search_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Name"
            android:inputType="textCapWords"
            android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />
        <Button
            android:id="@+id/btn_find"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="Find" />
        <Button
            android:id="@+id/btn_clear_search"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="Clear" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/dart_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:visibility="gone">
        <Button
            android:id="@+id/btn_dart"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="DART" />
        <Button
            android:id="@+id/btn_fireguard"
            android:layout_marginLeft="8dp"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="FireGuard" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
</ScrollView>
</LinearLayout>
