<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp">

    <!-- Pinned in the pane root, not inside a scroller: the status line is the one
         thing that must be readable without scrolling to it. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:textSize="13sp"
        android:textColor="@color/white"
        android:text="@string/status_waiting" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TakwerxSectionHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/heading_where" />

            <Button
                android:id="@+id/btn_states"
                style="@style/TakwerxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_counties"
                style="@style/TakwerxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <TextView
                style="@style/TakwerxSectionHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/heading_types" />

            <Button
                android:id="@+id/btn_categories"
                style="@style/TakwerxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_events"
                style="@style/TakwerxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <TextView
                style="@style/TakwerxSectionHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/heading_severity" />

            <Button
                android:id="@+id/btn_severity"
                style="@style/TakwerxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_refresh"
                style="@style/TakwerxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="@string/refresh_now" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
