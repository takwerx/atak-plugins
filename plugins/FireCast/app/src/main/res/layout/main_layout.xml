<?xml version="1.0" encoding="utf-8"?>
<!--
    The whole pane is one ListView, and every control lives in its header. A ListView
    inside a ScrollView measures itself to one row and the list stops scrolling, so the
    controls go in addHeaderView() instead and the panel is a single scroller. Click
    positions are then offset by getHeaderViewsCount().
-->
<ListView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detection_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:divider="#22FFFFFF"
    android:dividerHeight="1dp"
    android:fadeScrollbars="false"
    android:scrollbarStyle="outsideOverlay" />
