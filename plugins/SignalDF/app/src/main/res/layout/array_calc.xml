<?xml version="1.0" encoding="utf-8"?>
<!--
    Antenna array sizing. Two questions, one screen: what should I build for
    the frequency I am hunting, and will the array I already have work at it.

    The plan drawing sits between the inputs and the numbers on purpose , the
    picture is what stops somebody building to the radius when they meant the
    spacing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionHeading"
                android:text="Frequency you are hunting" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/freq"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="416.588 MHz" />

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/from_radio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="From radio" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeading"
                android:text="Your array" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/geometry"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Circular" />

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/elements"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="5 elements" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/size"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Radius 30.7 cm" />

                <Button
                    style="@style/TakwerxButton"
                    android:id="@+id/size_it"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="Size it for me" />
            </LinearLayout>

            <com.atakmap.android.signaldf.ui.ArrayPlanView
                android:id="@+id/plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/verdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp" />

            <TextView
                style="@style/SectionHeading"
                android:text="What you get" />

            <TextView
                android:id="@+id/numbers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.15" />

            <TextView
                style="@style/SectionHeading"
                android:text="This array covers" />

            <TextView
                android:id="@+id/band"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:alpha="0.7"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </ScrollView>

    <Button
        style="@style/TakwerxButton"
        android:id="@+id/close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:text="Done" />

</LinearLayout>
