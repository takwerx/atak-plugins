<?xml version="1.0" encoding="utf-8"?>
<!-- The stations as a list: what the map is drawing, ordered by how far away it is.
     The filters are the same three states the symbols are colored by, so the list and
     the map can never be answering different questions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/auto_margin"
    android:paddingRight="@dimen/auto_margin">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stations_page_heading"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:paddingTop="8dp"
        android:alpha="0.6" />

    <!-- Built in code so each carries its own count: a filter that says what it will
         cost before it is used, rather than one that has to be tried to be understood. -->
    <LinearLayout
        android:id="@+id/stations_filter_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/stations_scope_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/stations_page_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:text="" />

    <!-- A ListView cannot live inside a ScrollView, so the page is the list and
         anything above it would have to be a header. Here nothing does: the controls
         are fixed and the rows scroll under them. -->
    <ListView
        android:id="@+id/stations_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbarStyle="outsideOverlay" />

    <TextView
        android:id="@+id/stations_page_credit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:alpha="0.7"
        android:text="@string/credit_stations" />
</LinearLayout>
