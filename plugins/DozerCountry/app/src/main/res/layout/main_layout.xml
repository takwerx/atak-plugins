<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="8dp"
    android:paddingRight="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <!-- ====== AREA ====== -->
        <TextView
            style="@style/TakwerxSectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_area" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/draw_area"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/draw_area" />

            <Button
                android:id="@+id/clear_area"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:text="@string/clear" />
        </LinearLayout>

        <!-- What the plugin is doing or why nothing is drawn. Never silent. -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:text="@string/status_idle" />

        <!-- ====== OVERLAY ====== -->
        <TextView
            style="@style/TakwerxSectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_overlay" />

        <Button
            android:id="@+id/toggle_overlay"
            style="@style/TakwerxButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_off" />

        <TextView
            android:id="@+id/opacity_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:text="@string/opacity" />

        <SeekBar
            android:id="@+id/opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="60" />

        <!-- ====== SLOPE CLASSES ====== -->
        <TextView
            style="@style/TakwerxSectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_classes" />

        <!-- One row per band, built in code from dozer_data.json so the pane can
             never disagree with what the overlay actually painted. -->
        <LinearLayout
            android:id="@+id/band_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- What the overlay does not account for. Deliberately brighter and above
             the provenance line: an operator needs to know what is missing from the
             picture before they need to know whose table it came from. -->
        <TextView
            android:id="@+id/standard_caveat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFD37A"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/standard_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.6"
            android:textColor="@color/white"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
