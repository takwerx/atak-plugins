<?xml version="1.0" encoding="utf-8"?>
<!-- Three pages in one pane, by visibility swap: the main screen (the REPORTS list),
     Settings, and one report. The status line is pinned above all three. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:textSize="13sp"
        android:textColor="@color/white"
        android:text="@string/status_start" />

    <!-- The main row and the heading are this list's header, so the screen is one scroller. -->
    <ListView
        android:id="@+id/reports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#20FFFFFF"
        android:dividerHeight="1dp"
        android:fadeScrollbars="false"
        android:listSelector="@android:color/transparent" />

    <!-- Settings page. -->
    <LinearLayout
        android:id="@+id/settings_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btn_settings_back"
                style="@style/TakwerxButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="90dp"
                android:text="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:text="@string/settings" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:focusableInTouchMode="true"
            android:descendantFocusability="beforeDescendants">

            <LinearLayout
                android:id="@+id/settings_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp" />
        </ScrollView>
    </LinearLayout>

    <!-- One report, read only. -->
    <LinearLayout
        android:id="@+id/report_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- The report's name across the top, the controls under it
             (operator, 2026-11-14). -->
        <TextView
            android:id="@+id/report_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:maxLines="2"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <ImageButton
                android:id="@+id/btn_report_back"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back_arrow" />

            <ImageButton
                android:id="@+id/btn_report_goto"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/go_to" />

            <ImageButton
                android:id="@+id/btn_report_refresh"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/refresh" />

            <ImageButton
                android:id="@+id/btn_report_share"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/share"
                android:src="@drawable/ic_share" />

            <ImageButton
                android:id="@+id/btn_report_delete"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/delete" />

            <ImageButton
                android:id="@+id/btn_report_rename"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/rename" />

            <ImageButton
                android:id="@+id/btn_report_settings"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/settings" />

            <ImageButton
                android:id="@+id/btn_wide_report"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/wide"
                android:src="@drawable/ic_wide" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/report_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:focusableInTouchMode="true"
            android:descendantFocusability="beforeDescendants">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/report_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:textSize="14sp"
                    android:textColor="@color/white" />

                <LinearLayout
                    android:id="@+id/report_sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</LinearLayout>
