<?xml version="1.0" encoding="utf-8"?>
<!-- The whole pane is one ListView. A ListView cannot live inside a ScrollView, so the controls
     go in the list's own header instead of above it: that way the panel scrolls as one thing
     on a phone in portrait, where the controls alone are taller than the pane. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp">

    <ListView
        android:id="@+id/tfr_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#2a2a2a"
        android:dividerHeight="1dp"
        android:fadeScrollbars="false"
        android:scrollbarStyle="outsideOverlay" />

</LinearLayout>
