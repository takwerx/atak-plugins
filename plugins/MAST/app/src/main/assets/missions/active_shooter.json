     "geofence": {"trigger": "Both", "monitor": "All"}},
    {"label": "Casualty collection", "icon": "tile_ccp", "kind": "marker",
     "type": "b-m-p-s-m", "count": true},
    {"label": "Rally point", "icon": "tile_rally", "kind": "marker",
     "type": "b-m-p-s-m"},
    {"label": "Victim", "icon": "tile_victim", "kind": "marker",
     "type": "b-m-p-s-m", "count": true},
    {"label": "Deceased", "icon": "tile_deceased", "kind": "marker",
     "type": "b-m-p-s-m", "count": true},
    {"label": "Cleared room", "icon": "tile_room", "kind": "marker",
     "type": "b-m-p-s-m", "text": "Room number"},
    {"label": "Shooter LKP", "icon": "tile_shooter", "kind": "marker",
     "type": "a-h-G"},
    {"label": "Command post", "icon": "tile_cp", "kind": "marker",
     "type": "b-m-p-s-m"},
    {"label": "Staging", "icon": "tile_staging", "kind": "marker",
     "type": "b-m-p-s-m"},
    {"label": "Cameras", "icon": "tile_cameras", "kind": "plugin",
     "package": "com.atakmap.android.camdepot.plugin", "name": "Cam Depot"}
  ]
