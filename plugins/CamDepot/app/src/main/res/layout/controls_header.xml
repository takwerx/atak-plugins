<?xml version="1.0" encoding="utf-8"?>
<!-- The main screen: what is used in the field, then the list. Everything set
     once and left (where, what kind, radius, zoom gate, sync) is on the Settings
     page, so the list sits right under the buttons instead of three screens of
     controls down. Added to the ListView with addHeaderView() so the whole
     screen is one scroller; click positions are offset by getHeaderViewsCount(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Cameras ON/OFF | Settings | Favorites: the plugin-ui row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginTop="4dp">

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/toggle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <!-- Only as wide as its word: the two beside it carry a state and a count,
             and at half-pane width three equal thirds cut "Favorites (9)" short. -->
        <Button
            style="@style/TakwerxButton"
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/settings" />

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/favorites"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <!-- Which cameras cover a spot. A fire report is a point on the map, and with
         five cameras on one tower the only way to learn which one looks at it
         was to switch each bearing on and off. This asks the question once: the
         list narrows to the cameras whose reported pan and FOV cover the map
         center, best match first, with the PTZ cameras that could be turned to
         it and the nearby cameras that report no bearing in their own groups.
         In the field, so on the main screen. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginTop="6dp">

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/look_at"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/look_at_bearings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <!-- What the point costs, in the three groups the list shows. Gone while the
         filter is off. -->
    <TextView
        android:id="@+id/look_at_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:paddingTop="4dp"
        android:visibility="gone" />

    <!-- Search sits directly above the list because it changes what the next few
         inches of screen contain. Clear beside the box is the indicator as well
         as the control: a live Clear is the panel saying a search is on. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginTop="4dp">

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/search_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/clear" />
    </LinearLayout>

    <!-- Follows the map the way ATAK's Overlay Manager does, beside the one other
         thing done to the map from here: taking every bearing line down at once.
         Bearings go on one camera at a time, so there was no way to put a
         session's worth of them away. Disabled while none are on, with the count. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/in_view"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="On screen only" />

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/bearings_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        style="@style/TakwerxPageHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cameras" />

</LinearLayout>
