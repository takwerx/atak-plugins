<?xml version="1.0" encoding="utf-8"?>
<!-- Everything that is set once and left, off the main screen so the list sits right
     under the three buttons used in the field. Each row names its setting and its
     current value, and the arrow opens its controls. Rows start closed, so a closed
     page reads as a summary of every setting. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- What is drawn and where, first. -->
    <LinearLayout
        android:id="@+id/fold_gate_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/fold_gate_head"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/fold_gate_chev"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/show_settings"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fold_gate_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_use_zoom"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/use_this_zoom" />

            <Button
                android:id="@+id/btn_gate"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/gate_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/dim_text" />
    </LinearLayout>

    <!-- Types. -->
    <LinearLayout
        android:id="@+id/fold_types_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/fold_types_head"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/fold_types_chev"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/show_settings"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fold_types_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_types_all_on"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="All on" />

            <Button
                android:id="@+id/btn_types_all_off"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="All off" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/types_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp" />
    </LinearLayout>

    <!-- The map key, built from the same colors the map draws with. -->
    <LinearLayout
        android:id="@+id/fold_key_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/fold_key_head"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Map key" />

        <ImageButton
            android:id="@+id/fold_key_chev"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/show_settings"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fold_key_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone" />

    <!-- How often it updates, last. -->
    <LinearLayout
        android:id="@+id/fold_updates_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/fold_updates_head"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/fold_updates_chev"
            style="@style/TakwerxIconButton"
            android:layout_width="44dp"
            android:layout_weight="0"
            android:layout_marginRight="0dp"
            android:contentDescription="@string/show_settings"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fold_updates_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/updates_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/downloaded_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/dim_text" />
    </LinearLayout>

</LinearLayout>
