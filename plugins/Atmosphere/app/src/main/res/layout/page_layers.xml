<?xml version="1.0" encoding="utf-8"?>
<!-- Page 2: the overlays on the map, their shared scrubber and, as they land,
     each layer's own controls. -->
<!-- focusableInTouchMode + beforeDescendants: the scroller takes focus itself,
     so a rebuilt button (the chip row, the layer toggles) cannot pull the page down
     to itself on the next layout. Without it the forecast opened scrolled past the
     place, status and now-values (XCover, 2026-09-22). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="false"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!-- ====== LAYERS: overlays on the map, one toggle each, ON green / OFF red
             on a plain TakwerxButton the way Traffic does it. Time-enabled layers
             share the scrubber under the grid. ====== -->
        <TextView
            android:id="@+id/layers_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/heading_layers"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:paddingTop="8dp"
            android:alpha="0.6" />

        <!-- One layer per row, full width, so the list grows downward as layers
             land rather than squeezing more buttons across. Each layer's own
             controls sit under its toggle: wind's speed legend here, radar's
             transparency and dBZ scale when they come. -->
        <LinearLayout
            android:id="@+id/layer_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- A layer is a row: the toggle, and a chevron when it has settings to
                 show. The chevron folds the settings away while the layer stays on,
                 so a page of layers stays a page of layers (operator, 2026-09-22:
                 "the wind settings need to collapse even while on, so then i can get
                 to the other sections"). Every layer that lands follows this shape. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/radar_toggle"
                    style="@style/TakwerxButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/radar_off" />

                <ImageButton
                    android:id="@+id/radar_expand"
                    style="@style/TakwerxIconButton"
                    android:layout_width="44dp"
                    android:layout_weight="0"
                    android:contentDescription="@string/show_settings"
                    android:src="@drawable/ic_expand"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/radar_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/wind_toggle"
                    style="@style/TakwerxButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/wind_off" />

                <ImageButton
                    android:id="@+id/wind_expand"
                    style="@style/TakwerxIconButton"
                    android:layout_width="44dp"
                    android:layout_weight="0"
                    android:contentDescription="@string/show_settings"
                    android:src="@drawable/ic_expand"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wind_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- When: one strip, owned by whichever time-enabled layer is on. Only
                 one of them can be on at a time, so the strip is re-parented into
                 that layer's settings rather than duplicated; this is its home when
                 the wind has it. Live first, then the day, then the hour, all as
                 buttons: a slider on a pager page fights the pager sideways and
                 steals the page's scroll, and the operator could not work it
                 (XCover, 2026-09-22: "the slider very hard to work ... so like
                 live, then pick day and hour"). -->
            <LinearLayout
                android:id="@+id/scrubber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/scrubber_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:text="" />

                <LinearLayout
                    android:id="@+id/scrubber_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/scrubber_hours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- The speed legend, added in code so the custom view is built with the
                 plugin's own class loader. -->
            <LinearLayout
                android:id="@+id/wind_scale_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="4dp"
                android:visibility="gone" />

            <!-- Wind height: one preset button per level the models carry, lowest first. -->
            <LinearLayout
                android:id="@+id/wind_level_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- The wind where the pane is pointed. It answers "what is it doing
                     here", which the moving field alone cannot: the particles show a
                     shape, not a number (operator, 2026-09-23: "is there no extra
                     details if i click on the wind?"). The point is the pane's own
                     (self, map center, a picked point or a favorite), so Pick a point
                     is the click-to-read this asks for, and it already exists. -->
                <TextView
                    android:id="@+id/wind_reading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:text="" />

                <!-- A heading, not a readout: the lit button below says the height,
                     and the sentence that used to sit here also carried the model's
                     grid spacing, which is not a thing a crew can act on. -->
                <TextView
                    android:id="@+id/wind_level_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/heading_height"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:alpha="0.6" />

                <LinearLayout
                    android:id="@+id/wind_level_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
            </LinearLayout>

            <!-- Smoke: the model's smoke forecast, a time-enabled layer like the
                 wind, so the time strip moves in here when it is on. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/smoke_toggle"
                    style="@style/TakwerxButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/smoke_off" />

                <ImageButton
                    android:id="@+id/smoke_expand"
                    style="@style/TakwerxIconButton"
                    android:layout_width="44dp"
                    android:layout_weight="0"
                    android:contentDescription="@string/show_settings"
                    android:src="@drawable/ic_expand"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/smoke_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- The legend, added in code like the wind's. -->
                <LinearLayout
                    android:id="@+id/smoke_scale_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:paddingTop="4dp" />

                <!-- The smoke at the pane's own point, in words as well as a number. -->
                <TextView
                    android:id="@+id/smoke_reading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:text="" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/heading_height"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:alpha="0.6" />

                <!-- Two presets, the two the model carries: at the ground and the
                     whole sky. -->
                <LinearLayout
                    android:id="@+id/smoke_height_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Air quality: EPA AirNow's latest hour, not time-enabled, so it never
                 takes the strip and can be on beside any of the layers above. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/air_toggle"
                    style="@style/TakwerxButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/air_off" />

                <ImageButton
                    android:id="@+id/air_expand"
                    style="@style/TakwerxIconButton"
                    android:layout_width="44dp"
                    android:layout_weight="0"
                    android:contentDescription="@string/show_settings"
                    android:src="@drawable/ic_expand"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/air_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Which hour is on the map, or what went wrong. -->
                <TextView
                    android:id="@+id/air_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:text="" />

                <!-- EPA's six categories in EPA's colors, built in code from the same
                     table the map is drawn with. -->
                <LinearLayout
                    android:id="@+id/air_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal" />

                <!-- The category at the pane's own point. -->
                <TextView
                    android:id="@+id/air_reading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="4dp"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:text="" />
            </LinearLayout>

            <!-- Warnings: NWS warnings and watches, Red Flag first among them. Not
                 time-enabled; on beside anything. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/warn_toggle"
                    style="@style/TakwerxButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/warn_off" />

                <ImageButton
                    android:id="@+id/warn_expand"
                    style="@style/TakwerxIconButton"
                    android:layout_width="44dp"
                    android:layout_weight="0"
                    android:contentDescription="@string/show_settings"
                    android:src="@drawable/ic_expand"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/warn_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- What is in effect at the pane's own point: the answer to "am I in
                     a Red Flag Warning", which the map only shows. -->
                <TextView
                    android:id="@+id/warn_here"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:text="" />

                <TextView
                    android:id="@+id/warn_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:text="" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/heading_show"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:alpha="0.6" />

                <!-- Fire weather, land, marine: three switches, green when shown. -->
                <LinearLayout
                    android:id="@+id/warn_groups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tropical_toggle"
                    style="@style/TakwerxButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/tropical_off" />

                <ImageButton
                    android:id="@+id/tropical_expand"
                    style="@style/TakwerxIconButton"
                    android:layout_width="44dp"
                    android:layout_weight="0"
                    android:contentDescription="@string/show_settings"
                    android:src="@drawable/ic_expand"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- What is running, one line each: an empty map and a broken layer look
                 the same, and most of the year "no storms" is the true answer. -->
            <LinearLayout
                android:id="@+id/tropical_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tropical_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="4dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:text="" />

                <!-- What the track colors mean, on the Saffir-Simpson scale every
                     track map uses. Built in code so the swatches come from the same
                     table the map draws with and cannot drift from it. -->
                <LinearLayout
                    android:id="@+id/tropical_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/tropical_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Spot forecasts on the map, drawn the way NWS's own Spot Forecast
                 Monitor draws them. Not time-enabled; on beside anything. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/spot_toggle"
                    style="@style/TakwerxButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/spot_layer_off" />

                <ImageButton
                    android:id="@+id/spot_expand"
                    style="@style/TakwerxIconButton"
                    android:layout_width="44dp"
                    android:layout_weight="0"
                    android:contentDescription="@string/show_settings"
                    android:src="@drawable/ic_expand"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/spot_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/spot_layer_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:text="" />

                <!-- The filters live on the spot page, not here. Say so: without it
                     the layer looks like the only place to narrow what is drawn, and
                     its one toggle looks like the only filter there is (operator,
                     2026-09-25: "i have no way to filter on map or close to me, its
                     like that went away"). -->
                <TextView
                    android:id="@+id/spot_where_filters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:textSize="12sp"
                    android:alpha="0.7"
                    android:text="@string/spot_filters_elsewhere" />

                <Button
                    android:id="@+id/spot_open_only"
                    style="@style/TakwerxButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical|left"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/heading_legend"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:alpha="0.6" />

                <!-- NWS's legend, built in code so the discs are the same art the
                     map is drawing. -->
                <LinearLayout
                    android:id="@+id/spot_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fire weather stations, the way NWS's Fire Weather Snooper shows them:
             every station in an area with where the wind is from and the two numbers
             that decide a burn. Scoped by distance rather than held nationally. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/stations_toggle"
                    style="@style/TakwerxButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/stations_off" />

                <ImageButton
                    android:id="@+id/stations_expand"
                    style="@style/TakwerxIconButton"
                    android:layout_width="44dp"
                    android:layout_weight="0"
                    android:contentDescription="@string/show_settings"
                    android:src="@drawable/ic_expand"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stations_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/stations_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:text="" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/stations_around_heading"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:alpha="0.6" />

                <!-- Measured from the operator or from the middle of the map, which is
                     how a crew looks at a fire they are not standing on. -->
                <LinearLayout
                    android:id="@+id/stations_origin_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/stations_distance_heading"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:alpha="0.6" />

                <LinearLayout
                    android:id="@+id/stations_distance_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/heading_legend"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:alpha="0.6" />

                <LinearLayout
                    android:id="@+id/stations_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Says whose criteria these are, because they are not the local
                     office's own numbers yet. -->
                <TextView
                    android:id="@+id/stations_basis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:alpha="0.7"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- Credits what this page draws, which is not what the forecast page draws:
             the wind comes from NOAA's model files and the radar from an NWS map
             service, neither of them the forecast API. The forecast's own credit
             sits on the forecast page, where it used to be written into this view. -->
        <TextView
            android:id="@+id/layers_attribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_marginTop="@dimen/auto_margin"
            android:text="" />
    </LinearLayout>
</ScrollView>
