{
  "schemaVersion": 1,
  "id": "active_shooter",
  "name": "Active Shooter",
  "icon": "tile_shooter",
  "floors": true,
  "tiles": [
    {"label": "Base maps", "icon": "tile_basemaps", "kind": "atak",
     "action": "com.atakmap.android.maps.MANAGE_LAYERS"},
    {"label": "Overlays", "icon": "tile_overlays", "kind": "atak",
     "action": "com.atakmap.android.maps.MANAGE_HIERARCHY",
     "prefs": {"fov_filter": true}},
    {"label": "Find building", "icon": "tile_find", "kind": "atak",
