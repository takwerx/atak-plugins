<?xml version="1.0" encoding="utf-8"?>
<!-- The pane: the icon row pinned on top, page dots under it, and the pages in a
     pager below (the SDK helloworld TabViewDropDown pattern, ATAK's own ViewPager).
     A swipe or the arrow turns the page; each page scrolls on its own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginLeft="3dp"
    android:layout_marginRight="3dp">

        <!-- The icon row: what applies to every page: point modes, favorites,
             units, wide. Refresh and Settings act on the forecast only and live
             on the Forecast page.
             44 dp targets on ATAK's own button background, white masks tinted green
             for the mode in use (the Traffic toggle convention). Replaces the Source
             and Where button rows, so the readout starts one row down. -->
        <LinearLayout
            android:id="@+id/icon_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <ImageButton
                android:id="@+id/mode_self"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/self_position"
                android:src="@drawable/ic_point_self" />

            <ImageButton
                android:id="@+id/mode_center"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/map_center"
                android:src="@drawable/ic_point_center" />

            <ImageButton
                android:id="@+id/mode_pick"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/pick_point"
                android:src="@drawable/ic_point_pick" />

            <ImageButton
                android:id="@+id/favorites_button"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/favorites_title"
                android:src="@drawable/ic_favorites" />

            <Button
                android:id="@+id/units_button"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="@string/units_metric" />

            <ImageButton
                android:id="@+id/wide_button"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/wide"
                android:src="@drawable/ic_wide" />
        </LinearLayout>

        <!-- What each button above does, in words, one caption under each. Shown
             only when the buttons are wide enough to carry it (the pane opened
             wide, or a phone held upright); at half width the icons stand alone
             (operator, 2026-09-27: "when its wide like this can we put what each
             tool means underneath it"). -->
        <LinearLayout
            android:id="@+id/icon_captions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/cap_self"
                style="@style/TakwerxIconCaption"
                android:text="@string/caption_self" />

            <TextView
                android:id="@+id/cap_center"
                style="@style/TakwerxIconCaption"
                android:text="@string/caption_center" />

            <TextView
                android:id="@+id/cap_pick"
                style="@style/TakwerxIconCaption"
                android:text="@string/caption_pick" />

            <TextView
                android:id="@+id/cap_favorites"
                style="@style/TakwerxIconCaption"
                android:text="@string/caption_favorites" />

            <TextView
                android:id="@+id/cap_units"
                style="@style/TakwerxIconCaption"
                android:text="@string/caption_units" />

            <TextView
                android:id="@+id/cap_wide"
                style="@style/TakwerxIconCaption"
                android:text="@string/caption_full" />
        </LinearLayout>

        <!-- The pages by name, one tap to any of them, the one showing in green
             (operator, 2026-09-27: "another set of rows for each page to quickly
             get there"). One row of six when the pane is wide, two rows of three
             at half width where six names do not fit; built in code. Replaces the
             page dots and the next-page arrow. -->
        <LinearLayout
            android:id="@+id/page_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="4dp" />

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
</LinearLayout>
