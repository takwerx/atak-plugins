<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/fire_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/fire_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#BBBBBB"
            android:singleLine="true"
            android:ellipsize="end" />
        <!-- On a row with a NASA perimeter: a run from it without the feed on (operator,
             2026-11-02). Not focusable, or the row itself stops taking taps. -->
        <Button
            android:id="@+id/run_model"
            style="@style/TakwerxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:text="Run a Model from this perimeter"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/fire_power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:textSize="16sp"
        android:textColor="#FFFFFF" />
</LinearLayout>
