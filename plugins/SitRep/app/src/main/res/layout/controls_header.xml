<?xml version="1.0" encoding="utf-8"?>
<!-- The list's header: Draw area, Settings, the areas switch, then the list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btn_draw"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/draw_area" />

        <Button
            android:id="@+id/btn_settings"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/settings" />

        <Button
            android:id="@+id/btn_areas"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <TextView
        style="@style/TakwerxSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="@string/heading_reports" />

</LinearLayout>
