<?xml version="1.0" encoding="utf-8"?>
<!-- Feature Layer's result_row, which is the shape the operator asked for: a column of
     text, a Go button, and the distance on the right. The row itself opens details, and
     says so, because a row that only works if you guess is not a control. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clickable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_limits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#BBBBBB" />

        <!-- Type and state on one line, in the state's own map color, so the row and the
             map agree at a glance. -->
        <TextView
            android:id="@+id/row_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/row_details"
        style="@style/TakwerxButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text="Details" />

    <TextView
        android:id="@+id/row_window"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="8dp"
        android:gravity="right"
        android:textSize="14sp"
        android:textColor="@color/white" />

</LinearLayout>
