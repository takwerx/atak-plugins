<?xml version="1.0" encoding="utf-8"?>
<!-- The list's header: the three things used in the field, then the list. Everything
     set once and left is on the settings page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <!-- Wider than the two beside it, which is a deliberate break from the equal
             thirds the pane standard asks for: "AirAware OFF" does not fit a third of a
             half-width pane and ellipsized to "AirAware O...". A switch whose state you
             cannot read is not a switch. -->
        <Button
            android:id="@+id/btn_switch"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_settings"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/settings" />

        <Button
            android:id="@+id/btn_refresh"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/refresh" />
    </LinearLayout>

    <!-- The layers, on the front page where they are reached, not behind Settings.
         Each is its own switch with its own controls; "All off" is the one a crew
         actually reaches for when the map has filled up. -->
    <TextView
        style="@style/TakwerxSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="Layers" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/layers_all_on"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:text="All on" />

        <Button
            android:id="@+id/layers_all_off"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="All off" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layer_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/list_heading"
        style="@style/TakwerxSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="@string/heading_list" />

</LinearLayout>
