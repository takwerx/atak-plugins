<?xml version="1.0" encoding="utf-8"?>
<!--
    Feature Layer has no settings here: every choice is made on the pane next to
    the layer it affects. This screen exists so the manual has somewhere to be
    reached from. ATAK surfaces a plugin's documentation through its Tool
    Preferences entry, and without one the PDF ships inside the APK with no way
    for anyone to open it.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <com.atakmap.android.gui.PanPreference
        android:key="manual"
        android:title="@string/manual_title"
        android:summary="@string/manual_summary" />

</PreferenceScreen>
