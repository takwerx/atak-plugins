<?xml version="1.0" encoding="utf-8"?>
<!-- Page 2: the overlays on the map, their shared scrubber and, as they land,
     each layer's own controls. -->
<!-- focusableInTouchMode + beforeDescendants: the scroller takes focus itself,
     so a rebuilt button (the chip row, the layer toggles) cannot pull the page down
     to itself on the next layout. Without it the forecast opened scrolled past the
     place, status and now-values (XCover, 2026-09-22). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="false"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!-- ====== LAYERS: overlays on the map, one toggle each, ON green / OFF red
             on a plain TakwerxButton the way Traffic does it. Time-enabled layers
             share the scrubber under the grid. ====== -->
        <TextView
            android:id="@+id/layers_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/heading_layers"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:paddingTop="8dp"
            android:alpha="0.6" />

        <!-- One layer per row, full width, so the list grows downward as layers
             land rather than squeezing more buttons across. Each layer's own
             controls sit under its toggle: wind's speed legend here, radar's
             transparency and dBZ scale when they come. -->
        <LinearLayout
            android:id="@+id/layer_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/radar_toggle"
                style="@style/TakwerxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/radar_off" />

            <Button
                android:id="@+id/wind_toggle"
                style="@style/TakwerxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/wind_off" />

            <!-- When: shared by every time-enabled layer, so it sits with the
                 toggles rather than under one layer's controls. Live first, then
                 the day, then the hour, all as buttons: a slider on a pager page
                 fights the pager sideways and steals the page's scroll, and the
                 operator could not work it (XCover, 2026-09-22: "the slider very
                 hard to work ... so like live, then pick day and hour"). -->
            <LinearLayout
                android:id="@+id/scrubber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/scrubber_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:text="" />

                <LinearLayout
                    android:id="@+id/scrubber_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/scrubber_hours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- The speed legend, added in code so the custom view is built with the
                 plugin's own class loader. -->
            <LinearLayout
                android:id="@+id/wind_scale_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="4dp"
                android:visibility="gone" />

            <!-- Wind height: one preset button per level the models carry, lowest first. -->
            <LinearLayout
                android:id="@+id/wind_level_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/wind_level_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:text="" />

                <LinearLayout
                    android:id="@+id/wind_level_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/attribution_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_marginTop="@dimen/auto_margin"
            android:text="" />
    </LinearLayout>
</ScrollView>
