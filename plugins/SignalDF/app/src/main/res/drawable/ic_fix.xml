<?xml version="1.0" encoding="utf-8"?>
<!--
    The fix: where the transmitter is.

    A mast with two arcs radiating from its head. A vector rather than a PNG
    so it stays sharp at whatever size ATAK draws a marker, and white on
    transparent so Icon.Builder's setColor tints it, which is how the same
    glyph serves a live fix and a faded one.

    Drawn on a 64 unit square with the mast foot at the bottom centre, because
    the marker is anchored centre and a fix marks a point on the ground.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <!-- mast -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M30.5,26 h3 v30 h-3 z" />
    <!-- feet -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20,56 h24 v3 h-24 z" />
    <!-- head -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32,18 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />

    <!-- inner arcs, left and right -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M23,11 a13,13 0 0,0 0,14" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M41,11 a13,13 0 0,1 0,14" />

    <!-- outer arcs -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M16,6 a22,22 0 0,0 0,24" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:pathData="M48,6 a22,22 0 0,1 0,24" />
</vector>
