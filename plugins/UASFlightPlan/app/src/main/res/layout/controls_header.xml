<?xml version="1.0" encoding="utf-8"?>
<!-- The list's header: the three things used in the field, then the two numbers
     the pilot came for. Everything set once and left is on the Settings page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btn_islands"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_settings"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/settings" />

        <Button
            android:id="@+id/btn_launch"
            style="@style/TakwerxButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/launch_point" />
    </LinearLayout>

    <!-- The ground under the marker. Bigger than the rest: it is the number the
         pilot came for, and "0 AGL" beside it says it is the ground, not the
         phone's GPS altitude. -->
    <TextView
        android:id="@+id/ground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- "4,100 ft MSL is 1,086 ft above your launch point": the number that goes
         into the controller's altitude limit. -->
    <TextView
        android:id="@+id/ceiling"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/list_heading"
        style="@style/TakwerxSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:visibility="gone"
        android:text="@string/heading_obstacles" />

</LinearLayout>
