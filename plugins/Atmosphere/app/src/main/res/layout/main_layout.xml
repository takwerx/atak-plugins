<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="false"
    android:layout_marginLeft="3dp"
    android:layout_marginRight="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!-- The icon row: point modes, favorites, units, wide, refresh, settings.
             44 dp targets on ATAK's own button background, white masks tinted green
             for the mode in use (the Traffic toggle convention). Replaces the Source
             and Where button rows, so the readout starts one row down. -->
        <LinearLayout
            android:id="@+id/icon_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <ImageButton
                android:id="@+id/mode_self"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/self_position"
                android:src="@drawable/ic_point_self" />

            <ImageButton
                android:id="@+id/mode_center"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/map_center"
                android:src="@drawable/ic_point_center" />

            <ImageButton
                android:id="@+id/mode_pick"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/pick_point"
                android:src="@drawable/ic_point_pick" />

            <ImageButton
                android:id="@+id/favorites_button"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/favorites_title"
                android:src="@drawable/ic_favorites" />

            <Button
                android:id="@+id/units_button"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="@string/units_metric" />

            <ImageButton
                android:id="@+id/wide_button"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/wide"
                android:src="@drawable/ic_wide" />

            <ImageButton
                android:id="@+id/refresh_button"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/refresh"
                android:src="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/settings_button"
                style="@style/TakwerxIconButton"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/position_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/fontSize"
            android:layout_marginTop="@dimen/auto_margin"
            android:text="@string/no_position" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/fontSize"
            android:textColor="@color/heading_yellow"
            android:text="@string/status_idle" />

        <TextView
            android:id="@+id/current_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/heading_now"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:paddingTop="8dp"
            android:alpha="0.6" />

        <LinearLayout
            android:id="@+id/current_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/series_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/heading_hours"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:paddingTop="8dp"
            android:alpha="0.6" />

        <!-- The trend strip: one value across the coming hours as numbers on a line,
             the value chosen by the chip row under it. Both scroll sideways. -->
        <HorizontalScrollView
            android:id="@+id/trend_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/trend_host"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:id="@+id/trend_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- The hours as a table, every value per hour with the legend pinned on the
             left, behind a toggle: the graph is the default read, the table is there
             when a number for an hour is wanted. Closed by default. The scrollbar
             stays visible so it is plain that more hours are off screen, and sits in
             the padding under the last row rather than over it. -->
        <Button
            android:id="@+id/hours_table_button"
            style="@style/TakwerxButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/show_hours_table" />

        <LinearLayout
            android:id="@+id/hours_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/hours_legend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fadeScrollbars="false"
                android:scrollbarSize="3dp"
                android:scrollbarStyle="outsideOverlay"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/hours_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/days_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/heading_days"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:paddingTop="8dp"
            android:alpha="0.6" />

        <LinearLayout
            android:id="@+id/days_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/days_legend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fadeScrollbars="false"
                android:scrollbarSize="3dp">

                <LinearLayout
                    android:id="@+id/days_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ====== LAYERS: overlays on the map, one toggle each, ON green / OFF red
             on a plain TakwerxButton the way Traffic does it. Time-enabled layers
             share the scrubber under the grid. ====== -->
        <TextView
            android:id="@+id/layers_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/heading_layers"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:paddingTop="8dp"
            android:alpha="0.6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/radar_toggle"
                style="@style/TakwerxButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/radar_off" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scrubber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/scrubber_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:text="" />

            <SeekBar
                android:id="@+id/scrubber_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="0"
                android:progress="0" />
        </LinearLayout>

        <TextView
            android:id="@+id/attribution_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_marginTop="@dimen/auto_margin"
            android:text="" />
    </LinearLayout>
</ScrollView>
